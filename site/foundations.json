  "terms": [
    {
      "id": "correlation",
      "title": "相関",
      "reading": "そうかん",
      "aliases": [
        "correlation",
        "関連"
      ],
      "group": "design",
      "definition": "二つの変数が一緒に変わる傾向。片方を変えたときにもう片方が変わる、という因果関係と同じではありません。",
      "example": "架空例：通知の回数と疲労感が関連していても、多忙さが両方に関わった可能性があります。",
      "source_ids": [
        "SRC302"
      ],
      "locator": "25.2.1",
      "topic_ids": [
        "PSY-RES-001"
      ]
    },
    {
      "id": "causation",
      "title": "因果関係",
      "reading": "いんがかんけい",
      "aliases": [
        "causation",
        "因果"
      ],
      "group": "design",
      "definition": "ある要因の違いが結果に影響を与える関係。単なる関連や、前後の変化と区別して検討します。",
      "example": "架空例：机を片づけた後に作業量が増えても、仕事の種類や締め切りが変わっていないかを確認します。",
      "source_ids": [
        "SRC302"
      ],
      "locator": "25.2 / 25.5",
      "topic_ids": [
        "PSY-RES-001",
        "PSY-RES-010"
      ]
    },
    {
      "id": "confounding",
      "title": "交絡",
      "reading": "こうらく",
      "aliases": [
        "confounding",
        "第三の要因"
      ],
      "group": "design",
      "definition": "比較したい要因と結果の関係に、両方に関わる別の要因の影響が混ざること。調整後にも未測定の交絡が残り得ます。",
      "example": "架空例：忙しい人ほど通知も疲労感も多いなら、多忙さが第三の要因の候補になります。",
      "source_ids": [
        "SRC302"
      ],
      "locator": "25.2.1",
      "topic_ids": [
        "PSY-RES-001"
      ]
    },
    {
      "id": "randomization",
      "title": "ランダム化",
      "reading": "らんだむか",
      "aliases": [
        "randomization",
        "無作為割付",
        "RCT",
        "ランダム化比較試験"
      ],
      "group": "design",
      "definition": "介入などの割り付けを偶然の仕組みで決めること。参加者や担当者の判断で比較群が決まることを防ぎます。",
      "example": "参加者を社会全体から無作為に選ぶこととは別です。また、脱落や測定の偏りまで自動で消すわけではありません。",
      "source_ids": [
        "SRC302"
      ],
      "locator": "25.2",
      "topic_ids": [
        "PSY-RES-001"
      ]
    },
    {
