      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-MOT-009-SRC267",
      "topic_id": "PSY-MOT-009",
      "source_id": "SRC267",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "R5-3ed1f19c4641",
      "finding_scope_ja": "失敗後に自分へ思いやりを向ける操作を、自尊感情を高める条件や気をそらす条件などと比較した4実験です。実験の一つでは失敗後の難しいテストに向けて勉強する時間が長くなりました。",
      "conclusion_direction": "mixed",
      "limits_ja": "短期の実験で、長期の能力や仕事の成果の改善を保証しません。心の症状のメタ分析とは別に、再挑戦に近い行動を直接調べた根拠として扱います。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-MOT-008-SRC288",
      "topic_id": "PSY-MOT-008",
      "source_id": "SRC288",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "RL7-mindcritical2023",
      "finding_scope_ja": "63研究97672人。全研究の学業効果はd=.05、出版バイアス補正後は明確でなくなった。著者の基準で質が高い6研究ではd=.02/CI[-.06,.10]を報告。",
      "conclusion_direction": "mixed",
      "limits_ja": "全文・全コードの再解析は未実施。小さい平均効果から個別の学校の効果を否定しない。研究選別・分析をめぐる他のレビューとの議論を残す。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-MOT-008-SRC289",
      "topic_id": "PSY-MOT-008",
      "source_id": "SRC289",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "RL7-mindconditions2023",
      "finding_scope_ja": "複数の結果を扱う53独立標本の無作為化研究を整理。学業では支援対象を絞り実施の忠実度が高い条件でd=.14/CI[.06,.22]を報告し、予測区間は[-.08,.35]だった。",
      "conclusion_direction": "mixed",
      "limits_ja": "53すべてが学業試験とは限らない。条件付き推定を全員の平均へ置き換えない。信頼区間と新しい場面の予測区間は別。Macnamaraらと収載試験が重なり得る。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-MOT-008-SRC290",
      "topic_id": "PSY-MOT-008",
      "source_id": "SRC290",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "RL7-mindstructured2025",
      "finding_scope_ja": "学齢期の知能についてのマインドセットを扱う24RCTを整理。とくに信頼できると著者が評価した4試験は無効果から小さな効果の範囲とまとめた。",
      "conclusion_direction": "mixed",
      "limits_ja": "新たなメタ分析の統合値ではない。学齢期・知能の信念に限定し、性格、成人、他の心理指標へ拡張しない。著者の品質判断を独立して再実施したものではない。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-MOT-008-SRC291",
      "topic_id": "PSY-MOT-008",
      "source_id": "SRC291",
      "legacy_brief_ids": [],
      "relation_role": "context_only",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "RL7-mindproposal2026",
      "finding_scope_ja": "成長への信念と実際の学習行動を結びつけ、思い出す練習等との組み合わせを今後検証する必要を提案している。",
      "conclusion_direction": "mixed",
      "limits_ja": "組み合わせの上乗せ効果を検証した介入試験ではない。新しい論文という理由で、提案を確立済みの方法と扱わない。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-MOT-006-SRC295",
      "topic_id": "PSY-MOT-006",
      "source_id": "SRC295",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "RL8-perfection2017",
      "finding_scope_ja": "先延ばしと完璧主義的な懸念は平均r=.23、達成基準を追う側面はr=-.22という逆方向の関連を示した。二つの側面の共有分散を考慮した分析でも関連が残った。",
      "conclusion_direction": "mixed",
      "limits_ja": "相関の統合で、基準を下げる治療が先延ばしを減らす証明ではない。二つの分析の参加者は重なり得るので総人数を合算しない。一般的な診断テストとして使わない。",
      "formal_evidence_certainty": "not_assessed"
    }
