      "relevance_scope": "source_text_screened",
      "source_review_id": "SC6-SRC266",
      "finding_scope_ja": "嫌悪的課題を避けて短期の気分を優先することと将来の自己の目標の対立を論じる理論レビュー。",
      "conclusion_direction": "mixed",
