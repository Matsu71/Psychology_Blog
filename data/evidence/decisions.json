    {
      "id": "EV-PSY-DEC-002-SRC235",
      "topic_id": "PSY-DEC-002",
      "source_id": "SRC235",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "R5-f02e047ff253",
      "finding_scope_ja": "支払意思額・受取意思額へのアンカリングを扱う53研究を統合しています。平均的な効果は認められる一方、研究間のばらつきが大きく、研究の精度や出版に関する問題から平均効果を上限と考えるべきだと論じています。",
      "conclusion_direction": "mixed",
      "limits_ja": "実際の購入額を常に同じ割合で変える効果ではありません。質問の数値推定と実際のお金を使う選択を分け、より大規模な追試と比較します。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-DEC-002-SRC236",
      "topic_id": "PSY-DEC-002",
      "source_id": "SRC236",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "R5-45de362d3c7a",
      "finding_scope_ja": "経済的選択のアンカリングについて、検出力を高めた追試と再評価を報告しています。元の研究の大きな推定より小さく不確かな効果が示され、低い検出力の研究の大きな推定値への注意を促します。",
      "conclusion_direction": "mixed",
      "limits_ja": "特定の実験の追試であり、すべてのアンカリング現象を否定したものではありません。異なる研究手続きや対象まで同じ効果量を当てはめません。 自己追試であり完全に独立した再現ではありません。標本・アンカー幅・謝礼なども変更されています。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
      "id": "EV-PSY-DEC-004-SRC237",
      "topic_id": "PSY-DEC-004",
      "source_id": "SRC237",
      "legacy_brief_ids": [],
      "relation_role": "direct_or_targeted_evidence",
      "relevance_1_to_5": 5,
      "relevance_scope": "source_text_screened",
      "source_review_id": "R5-14fb6f3495da",
      "finding_scope_ja": "金銭的なサンクコストに関する98効果量を統合しています。支払済みのものを利用する判断と、さらに投資して続ける判断では、効果の大きさや時間経過などの条件の働き方が異なります。",
      "conclusion_direction": "mixed",
      "limits_ja": "一つの普遍的な倍率で説明しません。将来の便益、解約費用、学習効果など本当にこれから変わる要素まで無視するべき、という意味ではありません。",
      "formal_evidence_certainty": "not_assessed"
    },
    {
