{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Source review record",
  "type":"object",
  "required":["id","source_id","topic_ids","review_scope","key_findings_ja","limitations_ja","topic_relevance","method_signals","formal_evidence_certainty","publication_ready"],
  "properties":{
    "id":{"type":"string","pattern":"^R3-[CS][0-9]{3}$"},
    "source_id":{"type":"string","pattern":"^SRC[0-9]{3,}$"},
    "topic_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^PSY-[A-Z]{3}-[0-9]{3,}$"}},
    "review_scope":{"enum":["abstract","bibliography"]},
    "key_findings_ja":{"type":["string","null"]},
    "limitations_ja":{"type":"string","minLength":1},
    "topic_relevance":{"type":"integer","minimum":1,"maximum":5},
    "method_signals":{"type":"integer","minimum":1,"maximum":4},
    "formal_evidence_certainty":{"const":"not_assessed"},
    "publication_ready":{"const":false}
  },
  "allOf":[{"if":{"properties":{"review_scope":{"const":"bibliography"}}},"then":{"properties":{"key_findings_ja":{"type":"null"}}}}],
  "additionalProperties":true
}
